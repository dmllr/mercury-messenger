<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="hela.eillance.viewer.ViewerActivity">

  <SurfaceView
      android:id="@+id/output_surface"
      android:layout_width="match_parent"
      android:layout_height="250dp"
      app:layout_constraintTop_toTopOf="parent" />

  <Spinner
      android:id="@+id/select_camera"
      android:layout_width="wrap_content"
      android:layout_height="32dp"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/output_surface" />

  <Spinner
      android:id="@+id/select_camera_resolution"
      android:layout_width="wrap_content"
      android:layout_height="32dp"
      app:layout_constraintStart_toEndOf="@+id/select_camera"
      app:layout_constraintTop_toBottomOf="@+id/output_surface" />

  <ImageButton
      android:id="@+id/btn_change_surface_orientation"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:background="@android:color/transparent"
      android:contentDescription="@string/fr_observer_operation_change_video_orientation"
      android:src="@drawable/ic_surface_rotate"
      app:layout_constraintEnd_toEndOf="@+id/output_surface"
      app:layout_constraintTop_toBottomOf="@+id/output_surface"
      app:tint="?android:attr/colorForeground" />

</androidx.constraintlayout.widget.ConstraintLayout>

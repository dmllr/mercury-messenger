<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.src.camera.autofocus" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_camera_stream"
        android:label="@string/app_name"
        android:launchMode="singleTop"
        android:roundIcon="@drawable/ic_camera_stream"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="hela.eillance.viewer.ViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name="hela.eillance.streamer.StreamerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name="hela.eillance.LauncherActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="hela.eillance.streamer.StreamerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|connectedDevice">
        </service>
    </application>

</manifest>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/preference_category_camera">
        <ListPreference
            app:key="default_camera"
            app:title="@string/preference_default_camera"
            app:defaultValue="0" />
        <ListPreference
            app:key="camera_resolution"
            app:title="@string/preference_camera_resolution" />
    </PreferenceCategory>

</PreferenceScreen>

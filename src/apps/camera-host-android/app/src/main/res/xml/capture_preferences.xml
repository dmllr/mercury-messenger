<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <PreferenceCategory
      android:title="@string/preference_category_camera_encoding"
      app:icon="@drawable/ic_pref_group_camera_encoding">
    <ListPreference
        app:defaultValue="0"
        app:icon="@drawable/ic_pref_default_camera"
        app:key="default_camera"
        app:title="@string/preference_default_camera" />
    <ListPreference
        app:icon="@drawable/ic_pref_camera_resolution"
        app:key="camera_resolution"
        app:title="@string/preference_camera_resolution" />
    <ListPreference
        app:icon="@drawable/ic_pref_frame_rate"
        app:key="frame_rate"
        app:title="@string/preference_frame_rate" />
    <ListPreference
        app:icon="@drawable/ic_pref_bitrate"
        app:key="bitrate"
        app:title="@string/preference_bitrate" />
  </PreferenceCategory>

  <PreferenceCategory
      android:title="@string/preference_category_camera_encoding"
      app:icon="@drawable/ic_pref_group_camera_encoding">

  </PreferenceCategory>

</PreferenceScreen>

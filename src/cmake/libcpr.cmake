# Modern C++ HTTP library

if (TARGET "cpr")
  return()
endif()

set(FETCHCONTENT_BASE_DIR "${CMAKE_BINARY_DIR}/_deps_libcpr")

set(CURL_ZLIB OFF CACHE INTERNAL "" FORCE)
set(CURL_USE_MBEDTLS OFF CACHE INTERNAL "" FORCE)
set(CURL_USE_LIBPSL OFF CACHE INTERNAL "" FORCE)
set(HAVE_LIBSOCKET OFF CACHE BOOL "Disable libsocket detection" FORCE)
set(ENABLE_CURL_MANUAL OFF CACHE BOOL "" FORCE)
set(BUILD_LIBCURL_DOCS OFF CACHE BOOL "" FORCE)
set(BUILD_CURL_EXE OFF CACHE INTERNAL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE INTERNAL "" FORCE)
set(BUILD_TESTING OFF CACHE INTERNAL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE INTERNAL "" FORCE)
set(CPR_BUILD_TESTS OFF CACHE INTERNAL "" FORCE)

if (${ENABLE_MBEDTLS})
  set(CPR_FORCE_MBEDTLS_BACKEND ON CACHE INTERNAL "" FORCE)
endif()
if (${ENABLE_OPENSSL})
  set(CPR_FORCE_OPENSSL_BACKEND ON CACHE INTERNAL "" FORCE)
endif()

if(WIN32)
  add_definitions(-DNOMINMAX)
endif()

if (TARGET "libcurl_static")
  set(CPR_USE_SYSTEM_CURL ON CACHE BOOL "" FORCE)
  set(CURL_FOUND TRUE CACHE BOOL "" FORCE)
  set(CURL_SUPPORTS_HTTPS TRUE CACHE BOOL "Curl supports HTTPS" FORCE)
  set(CURL_SUPPORTS_HTTP TRUE CACHE BOOL "Curl supports HTTP" FORCE)
  set(CURL_LIBRARY libcurl_static)
  set(CURL_LIBRARIES libcurl_static)
endif()

import_remote(
  "https://github.com/libcpr/cpr.git"
  TAG "1.11.2"
  DST "${CMAKE_SOURCE_DIR}/_imported"
  ALIAS cpr
)

# Modern C++ HTTP library

set(CURL_ZLIB OFF CACHE INTERNAL "" FORCE)
set(CURL_USE_MBEDTLS OFF CACHE INTERNAL "" FORCE)
set(CURL_USE_LIBPSL OFF CACHE INTERNAL "" FORCE)
set(HAVE_LIBSOCKET OFF CACHE BOOL "Disable libsocket detection" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE INTERNAL "" FORCE)
set(CPR_BUILD_TESTS OFF CACHE INTERNAL "" FORCE)

if (${ENABLE_MBEDTLS})
  set(CPR_FORCE_MBEDTLS_BACKEND ON CACHE INTERNAL "" FORCE)
endif()

if(WIN32)
  add_definitions(-DNOMINMAX)
endif()
import_remote("https://github.com/libcpr/cpr.git" TAG "1.11.2" DST "${CMAKE_SOURCE_DIR}/_imported" ALIAS cpr)
